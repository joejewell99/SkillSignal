# Copy this file to .env.production locally or into your hosting provider's secret store.
# Never commit the populated file.
POSTGRES_DB=skillsignal
POSTGRES_USER=skillsignal
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
PUBLIC_ORIGIN=https://your-domain.example
AUTH_COOKIE_SECURE=true
VITE_TURNSTILE_SITE_KEY=replace-with-your-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-your-cloudflare-turnstile-secret-key
TURNSTILE_EXPECTED_HOSTNAME=your-domain.example
TRUST_FORWARDED_FOR=false
AUTH_REQUESTS_PER_MINUTE=10
WRITE_REQUESTS_PER_MINUTE=300
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=80
