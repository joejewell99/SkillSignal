OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required outside tests. Generate a random value of at least 32 characters.
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
# Keep false for local HTTP development; set true in HTTPS production.
AUTH_COOKIE_SECURE=false

# Database credentials must be supplied by the deployment secret manager.
DB_URL=jdbc:postgresql://localhost:5432/skillsignal
DB_USERNAME=
DB_PASSWORD=
JPA_DDL_AUTO=validate
POSTGRES_DB=skillsignal
POSTGRES_USER=
POSTGRES_PASSWORD=

# Optional local-only seed data. Keep false in production.
DEMO_DATA_ENABLED=false

# Optional admin bootstrap. Leave blank to disable automatic admin creation.
SKILLSIGNAL_ADMIN_EMAIL=
SKILLSIGNAL_ADMIN_PASSWORD=
